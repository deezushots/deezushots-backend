# Copy this file to .env for local development (Render: set these in the dashboard instead)
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
DEFAULT_ADMIN_PASSWORD=DeezuShots2026
FRONTEND_URL=https://myusername.github.io

# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/deezu-shots

# Cloudinary ‚Äî from your Cloudinary dashboard's "API Environment variable"
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

